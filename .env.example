# Nuxt App Secret (used for sessions, cryptographic signing, and auth)
# Generate with: openssl rand -hex 32
NUXT_APP_SECRET=

# Cloudflare Deployment (optional for CLI deploy if logged in via `qp login`)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Custom Cloudflare Worker Name (optional override)
# QARPEO_WORKER_NAME=starter
